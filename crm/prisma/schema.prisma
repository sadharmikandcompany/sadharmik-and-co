generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id            String      @id @default(cuid())
  name          String      @unique
  packSize      String
  price         Int
  // Optional per-tier overrides for Mandir/Shop customers (see
  // Customer.isMandir / Customer.isShop). null means "no special price
  // set for this tier — use the regular `price`."
  mandirPrice   Int?
  shopPrice     Int?
  gstPercentage Int         @default(0)
  stock         Int         @default(0)
  isActive      Boolean     @default(true)
  // Independent of isActive: a product can stay usable internally (POS,
  // New Order) while being hidden from the public website's catalogue.
  showOnWebsite Boolean     @default(true)
  // Shown on the public website's product cards. Nullable so existing rows
  // (and quick "just add a flavour" entries) don't need a photo/blurb up front.
  imageUrl      String?
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
}

model Customer {
  id               String   @id @default(cuid())
  vipNumber        Int      @default(autoincrement()) @unique
  firstName        String
  lastName         String
  email            String?
  mobilePrimary    String
  whatsapp         String?
  mobileSecondary1 String?
  mobileSecondary2 String?
  companyName      String?
  gstNumber        String?
  panNumber        String?
  shippingAddress  String
  billingAddress   String?
  isVip            Boolean  @default(false)
  isMandir         Boolean  @default(false)
  mandirNumber     Int?     @unique
  isShop           Boolean  @default(false)
  shopNumber       Int?     @unique
  isDefaulter      Boolean  @default(false)
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  orders           Order[]
}

model Supplier {
  id            String     @id @default(cuid())
  name          String
  phone         String
  itemsSupplied String?
  notes         String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  purchases     Purchase[]
}

enum OrderStatus {
  NEW
  ROASTING
  OUT_FOR_DELIVERY
  PICKED_UP
  DELIVERED
  FAILED
  RESCHEDULED
  CANCELLED
}

enum OrderSource {
  WEBSITE
  WHATSAPP
  PHONE
  WALK_IN
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  CHEQUE
  PENDING
}

enum Role {
  ADMIN
  STAFF
  DELIVERY_PARTNER
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String?   @unique
  phone           String    @unique
  passwordHash    String
  role            Role      @default(STAFF)
  isActive        Boolean   @default(true)
  servicePincodes String[]  @default([])
  rating          Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  deliveries      Order[]   @relation("OrderDeliveryPartner")
  expenses        Expense[]
  routeAssignments RouteAssignment[] @relation("RouteAssignmentDeliveryPartner")
}

model Expense {
  id          String   @id @default(cuid())
  riderId     String
  rider       User     @relation(fields: [riderId], references: [id])
  amount      Int
  category    String?
  notes       String?
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  invoiceNumber     Int           @unique @default(autoincrement())
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id])
  deliveryPartnerId String?
  deliveryPartner   User?         @relation("OrderDeliveryPartner", fields: [deliveryPartnerId], references: [id])
  routeAssignmentId String?
  routeAssignment   RouteAssignment? @relation(fields: [routeAssignmentId], references: [id])
  status            OrderStatus   @default(NEW)
  source            OrderSource   @default(WALK_IN)
  paymentMethod     PaymentMethod @default(CASH)
  notes             String?
  deliveryNotes     String?
  isPriority        Boolean       @default(false)
  rescheduledDate   DateTime?
  rescheduleReason  String?
  settledAt         DateTime?
  subtotal          Int
  gstAmount         Int           @default(0)
  deliveryCharge    Int
  total             Int
  amountPaid        Int           @default(0)
  orderDate         DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             OrderItem[]
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  order             Order   @relation(fields: [orderId], references: [id])
  productId         String
  product           Product @relation(fields: [productId], references: [id])
  quantity          Int
  unitPrice         Int
  discountPercentage Int    @default(0)
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routeAssignments RouteAssignment[]
}

enum RouteAssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// A batch of orders dispatched together out of one warehouse — the
// "Route Assignment" feature. Named routes (Route 1, Route 2, ...) are a
// later addition; for now each assignment is just its own numbered batch.
model RouteAssignment {
  id                String                @id @default(cuid())
  routeNumber       Int                   @unique @default(autoincrement())
  warehouseId       String
  warehouse         Warehouse             @relation(fields: [warehouseId], references: [id])
  deliveryPartnerId String?
  deliveryPartner   User?                 @relation("RouteAssignmentDeliveryPartner", fields: [deliveryPartnerId], references: [id])
  status            RouteAssignmentStatus @default(PENDING)
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  orders            Order[]
}

enum PaidStatus {
  PAID
  DUE
  PARTIAL
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model Purchase {
  id           String         @id @default(cuid())
  supplierId   String
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  poNumber     String?        @unique
  invoiceNumber String?
  purchaseDate DateTime       @default(now())
  total        Int
  amountPaid   Int            @default(0)
  paidStatus   PaidStatus     @default(DUE)
  purchaseStatus PurchaseStatus @default(PENDING)
  paymentMethod String?
  batchNumber  String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  items        PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  itemName   String
  quantity   Float
  unit       String
  rate       Int
  amount     Int
}
